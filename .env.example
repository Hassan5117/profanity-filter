# Copy this file to .env (gitignored) and add your API keys.
# Precedence: shell environment variables > .env > ~/.config/censor_app/config.json

# OpenSubtitles REST API v1 key (https://www.opensubtitles.com/consumers)
OPENSUBTITLES_API_KEY=

# Optional OpenSubtitles account credentials (for higher daily download quota via JWT)
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Optional SubDL API key (https://subdl.com)
SUBDL_API_KEY=
